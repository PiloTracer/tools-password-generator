# Production image: Next.js 16 standalone server + Python generator.
# The standalone output bundles only the files the server needs at runtime;
# Python 3 is installed because /api/generate shells out to password_generator.py.
FROM node:22-bookworm AS deps

WORKDIR /app/password

COPY password/package.json password/package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM node:22-bookworm AS builder

WORKDIR /app/password

ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/password/node_modules ./node_modules
COPY password/ ./
RUN npm run build

FROM node:22-bookworm AS runner

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 \
      python-is-python3 \
      tzdata \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    TZ=America/Costa_Rica \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Next.js standalone server bundle (includes traced node_modules).
COPY --from=builder --chown=node:node /app/password/.next/standalone ./
COPY --from=builder --chown=node:node /app/password/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/password/public ./public

COPY --chown=node:node password_generator.py ./password_generator.py
COPY --chown=node:node eff_short_wordlist_1.txt ./eff_short_wordlist_1.txt

USER node

EXPOSE 3000

CMD ["node", "server.js"]
