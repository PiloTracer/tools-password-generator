# Development image: Next.js dev server + Python generator.
# Source code is bind-mounted at run time by docker-compose.dev.yml, so this
# image only bakes in dependencies and the shared generator assets.
FROM node:22-bookworm

ENV NEXT_TELEMETRY_DISABLED=1 \
    TZ=America/Costa_Rica \
    WATCHPACK_POLLING=true \
    CHOKIDAR_USEPOLLING=true \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 \
      python-is-python3 \
      tzdata \
      ca-certificates \
      curl \
      procps \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /code/password

# Install dependencies first so Docker can cache this layer.
COPY password/package.json password/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY password/ ./
COPY password_generator.py /code/password_generator.py
COPY eff_short_wordlist_1.txt /code/eff_short_wordlist_1.txt

EXPOSE 3000 9229

CMD ["npm", "run", "dev"]
