# =============================================================================
#  Secure Password Generator - environment configuration
#
#  .env.example is the canonical reference. .env.dev and .env.prd must contain
#  exactly the same keys on the same lines; verify with:
#      ./bin/check-env-parity.sh
#
#  Host ports are intentionally identical for dev and prd:
#    app 18000 | secrets manager 18001 | debug 18002 | public HTTP/HTTPS 80/443
#  Public TLS is terminated by the production host's nginx (deploy/nginx).
#  Run only one environment per host at a time.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment identity
# -----------------------------------------------------------------------------
# dev | prd. Must match the file name suffix.
APP_ENV="<dev|prd>"
# Reported by /api/health.
APP_VERSION=1.0.0
# Compose project name; isolates containers, networks and volumes.
COMPOSE_PROJECT_NAME="<passwordgenerator_dev|passwordgenerator_prd>"

# -----------------------------------------------------------------------------
# Host networking (same ports in dev and prd)
# -----------------------------------------------------------------------------
# Bind address and published port for the web app.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT="<18000>"
# Debug port mapping (development only; prd keeps the value but does not publish it).
APP_DEBUG_BIND_ADDRESS=127.0.0.1
APP_DEBUG_PORT="<18002>"

# -----------------------------------------------------------------------------
# Production ingress (host nginx; values are reserved in dev)
# -----------------------------------------------------------------------------
# Public DNS names; both resolve to this host.
APP_HOST="<agiolab.com>"
SECRETS_MANAGER_HOST="<secrets.agiolab.com>"
# Public HTTPS URLs (standard 443; host nginx terminates TLS).
APP_PUBLIC_URL="<https://agiolab.com>"
SECRETS_MANAGER_PUBLIC_URL="<https://secrets.agiolab.com>"
# Public HTTPS port terminated by host nginx.
PUBLIC_HTTPS_PORT="<443>"

# -----------------------------------------------------------------------------
# AWS-compatible Secrets Manager
# -----------------------------------------------------------------------------
SECRETS_MANAGER_BIND_ADDRESS=127.0.0.1
SECRETS_MANAGER_PORT="<18001>"
SECRETS_MANAGER_REGION=us-east-1
SECRETS_MANAGER_ACCOUNT_ID=000000000000

# SigV4 access key id used by the app, the CLI and the AWS SDKs.
SECRETS_MANAGER_ACCESS_KEY_ID="<access-key-id>"
# 64 hex characters; generate with: openssl rand -hex 32
# secret
SECRETS_MANAGER_SECRET_ACCESS_KEY="<openssl rand -hex 32>"
# Optional session token (validated when set).
# optional
SECRETS_MANAGER_SESSION_TOKEN=
# Optional 32-byte master key (64 hex or base64). Empty = generated in the volume.
# optional secret
SECRETS_MANAGER_MASTER_KEY=

# Per-client SigV4 credentials (JSON array); each client is limited to
# its allowedPrefixes. The main SM_ACCESS_KEY_ID remains the admin key.
# secret
SM_CLIENTS_JSON='<json-array-of-client-credentials>'

# -----------------------------------------------------------------------------
# Application runtime
# -----------------------------------------------------------------------------
SECRETS_MANAGER_ENABLED=true
SECRETS_MANAGER_ENDPOINT=http://secrets-manager:8080
# Secret names read by the app (also used by the seeder).
APP_CONFIG_SECRET_ID="password-generator/<dev|prd>/app-config"
INTEGRITY_SECRET_ID="password-generator/<dev|prd>/integrity"
# How long the app caches policy/integrity values.
SECRETS_CACHE_TTL_MS="<15000|60000>"
# Paths inside the container.
PASSWORD_GENERATOR_SCRIPT="</code/password_generator.py|/app/password_generator.py>"
WORDLIST_PATH="</code/eff_short_wordlist_1.txt|/app/eff_short_wordlist_1.txt>"
PYTHON_BIN=python3
LOG_LEVEL="<debug|info>"
TZ=America/Costa_Rica

# -----------------------------------------------------------------------------
# Backups
# -----------------------------------------------------------------------------
# Image used to stream volume contents into tar.gz archives.
BACKUP_TAR_IMAGE=alpine:3.20
# Number of backups kept per environment (0 = keep all).
BACKUP_RETENTION="<7|14>"
